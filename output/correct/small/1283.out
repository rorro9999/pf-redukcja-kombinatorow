a d = d
b = a
c = a b
main = A c B C (a D b (a a c))
------------------------------------------------------------
A c B C (a D b (a a c))
A (a b) B C (a D b (a a c))
A b B C (a D b (a a c))
A a B C (a D b (a a c))
A a B C (D b (a a c))
A a B C (D a (a a c))
A a B C (D a (a c))
A a B C (D a c)
A a B C (D a (a b))
A a B C (D a b)
A a B C (D a a)


