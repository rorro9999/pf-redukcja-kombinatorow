a g f h e = d f d c
b g f e = e (a d) d c
c g f e = a (f f e)
d = b c (c b a)
main = A b b B C D (b c (E c c a b d d))
------------------------------------------------------------
A b b B C D (b c (E c c a b d d))
A b b B C D (b c (E c c a b (b c (c b a)) d))
A b b B C D (b c (E c c a b (b c (c b a)) (b c (c b a))))


