main = A B C d D a E (F (e d (d G e) d e))
d i g h f = f e
c f h g i = b b i a b f
a f h g = c (h d) b c
e g i f h = d (h b b g c g)
b g i h f = a a
------------------------------------------------------------
A B C d D a E (F (e d (d G e) d e))
A B C d D a E (F (d (e b b d c d)))
A B C d D a E (F (d (d (c b b b c b) d)))
A B C d D a E (F (d (d (b b c a b b b) d)))
A B C d D a E (F (d (d (a a b b) d)))
A B C d D a E (F (d (d (c (b d) b c) d)))


